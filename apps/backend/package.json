{
  "name": "@rtsearch/backend",
  "version": "0.1.0",
  "private": true,
  "description": "High-availability search API with pluggable engines and failover (TypeScript)",
  "main": "dist/index.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite-node --watch --env-file ../../.env ./src/index.ts",
    "build": "tsc && yarn build-engines && yarn rename-js && yarn fix-imports",
    "build-engines": "tsc --project engines/tsconfig.json",
    "rename-js": "node -e \"const fs=require('fs');const path=require('path');function renameFiles(dir){fs.readdirSync(dir,{withFileTypes:true}).forEach(entry=>{const fullPath=path.join(dir,entry.name);if(entry.isDirectory()){renameFiles(fullPath);}else if(entry.name.endsWith('.js')){const newPath=fullPath.replace('.js','.mjs');fs.renameSync(fullPath,newPath);}});}renameFiles('dist');\"",
    "fix-imports": "node fix-imports.js",
    "start": "node dist/index.mjs",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.0",
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "^6.13.0",
    "bcrypt": "^6.0.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.4.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "opossum": "^9.0.0",
    "pino": "^9.8.0",
    "prom-client": "^15.1.3",
    "undici": "^7.13.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.2.1",
    "esbuild": "^0.25.8",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prisma": "^6.13.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.1",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
