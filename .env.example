# ===========================================
# RealtimeSearch Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database ---
# PostgreSQL connection string.
# Docker Compose users: DATABASE_URL is set automatically in docker-compose.yml,
# you do NOT need to set it here.
# Manual install users: uncomment and set the URL below.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/search_and_translate

# --- Server ---
PORT=8787
HOST=0.0.0.0

# --- Search Engines ---
# Comma-separated list of enabled search engines
SEARCH_ENGINES=serper,brave,bing

# API keys for each search engine (obtain from their respective dashboards)
SERPER_API_KEYS=your_serper_key
BRAVE_API_KEYS=your_brave_key
BING_API_KEYS=your_bing_key

# --- Translation Engines ---
# Comma-separated list of enabled translation engines
TRANSLATE_ENGINES=google,deepl

# API keys for each translation engine
GOOGLE_API_KEYS=your_google_key
DEEPL_API_KEYS=your_deepl_key

# --- Authentication ---
AUTH_JWT_SECRET=change-me-to-a-random-secret
AUTH_ALLOW_SIGNUP=true
AUTH_REQUIRE_LOGIN=true

# --- TLB (Token Leaky Bucket) — Failover & Load Balancing ---
TLB_ENABLED=true
TLB_DEFAULT_RPS=20
TLB_ENABLE_HOT_SWAP=true
TLB_TOKEN_RETURN_DELAY_MS=1000
TLB_MAX_RETRIES=3

# --- Optional: Redis Cache ---
# REDIS_URL=redis://localhost:6379

# --- Optional: ClickHouse Analytics ---
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=

# --- Optional: HTTP Proxy ---
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port
# NO_PROXY=localhost,127.0.0.1
