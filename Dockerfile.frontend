# 前端 Dockerfile
FROM node:22-alpine AS builder

WORKDIR /app

# 启用Corepack并准备Yarn（使用官方源，设置较长超时）
RUN corepack enable && \
    export COREPACK_DEFAULT_TO_LATEST=0 && \
    corepack prepare yarn@4.9.2 --activate || \
    (sleep 5 && corepack prepare yarn@4.9.2 --activate) || \
    (sleep 10 && corepack prepare yarn@4.9.2 --activate)

# 配置npm镜像源
RUN npm config set registry https://registry.npmmirror.com/

# 复制根目录的package.json和yarn.lock
COPY package.json yarn.lock ./

# 复制整个项目结构（因为需要workspace配置）
COPY . .

# 创建/覆盖 .yarnrc.yml 配置文件以使用镜像源
RUN echo "nodeLinker: node-modules" > .yarnrc.yml && \
    echo "npmRegistryServer: \"https://registry.npmmirror.com/\"" >> .yarnrc.yml && \
    echo "httpTimeout: 60000" >> .yarnrc.yml

# 安装依赖
RUN yarn install

# 构建前端
RUN yarn workspace @rtsearch/web build

# 生产运行阶段
FROM nginx:alpine AS runner

# 复制构建产物到nginx目录
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# 复制nginx配置
COPY nginx.conf /etc/nginx/nginx.conf

# 暴露80端口（nginx默认端口）
EXPOSE 80

# 启动nginx
CMD ["nginx", "-g", "daemon off;"]
